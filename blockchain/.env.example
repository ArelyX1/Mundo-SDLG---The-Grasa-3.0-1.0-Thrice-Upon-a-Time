# ===== Nodo SDLG-JAM =====
JAM_NETWORK=sdlg-jam
JAM_NODE_NAME=validator-0
JAM_DATA_DIR=./data
JAM_GENESIS=./genesis/genesis.json
JAM_WALLET_DIR=./wallets

# Puertos
JAM_P2P_PORT=30334
JAM_RPC_PORT=9944
JAM_API_PORT=8080

# RPC estilo Ethereum (puente EVM / MetaMask)
JAM_EVM_PORT=8545

# Icono de la red en HTTPS (MetaMask ignora iconUrls en http://). Si se deja vacio,
# se usa una copia publicada del logo de la red (https://files.catbox.moe/x6tiah.png).
JAM_EVM_ICON_URL=

# Icono del token PAPU (facade ERC-20) visto por wallet_watchAsset. Si se deja vacio,
# se usa el pacman (https://files.catbox.moe/qohmwt.png).
JAM_EVM_TOKEN_IMAGE_URL=

# Semilla de red (otros nodos). Separada por comas: HOST:PORT
JAM_SEED_PEERS=

# Escuchar en todas las interfaces (server / docker). true|false
JAM_LISTEN_ALL=false

# Tiempo de timeslot (segundos). Gray Paper: 6
JAM_TIMESLOT_SECS=6

# Direccion del emisor de moneda (delegacion de minteo)
JAM_ISSUER_ADDRESS=

# Log
JAM_LOG_LEVEL=info