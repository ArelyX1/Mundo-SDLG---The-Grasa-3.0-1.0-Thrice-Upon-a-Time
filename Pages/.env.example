# Configuracion del sitio. Copia esto a .env y ajusta lo que necesites:
#
#   cp .env.example .env
#
# El servidor lee, en este orden y gana el ultimo:
#   .env  ->  .env.local  ->  .env.<modo>  ->  .env.<modo>.local
#
# Lo que este ya en el entorno real gana sobre los archivos, asi que en
# produccion se puede pasar todo por variables sin tocar el .env.

# Puerto donde escucha el sitio. / es la salud y /connect la wallet.
PORT=4321

# Nodos que el sitio puede mirar, separados por comas.
#
# Basta con UNO que la pagina pueda alcanzar: ese nodo responde a network_map
# con quien esta en la red (el y sus peers, con sus direcciones P2P) y la pagina
# se descubre el resto sola. Asi no hay que mantener la lista de la red en la
# web: se anade un nodo, entra al mesh, y la web lo ve al sondear de nuevo.
#
# El peer se anuncia con su direccion P2P; el panel prueba los puertos RPC
# candidatos (el RPC del seed, el 9944, y la convencion del devnet P2P-21390).
# Para una topologia con puertos RPC propios, lista aqui todos los nodos y la
# pagina los usa tal cual, sin probar puertos.
#
# La red tolera que cualquier validador caiga: con --skip-missing-authors el
# suplente escribe el turno del autor muerto y la cadena sigue avanzando. El
# panel muestra todos los validadores, cuales responden, y anota caidas y
# recuperaciones sin recargar.
#
# Con esto vacio, el sitio barre los puertos de localhost del rango SCAN_FROM a
# SCAN_TO, que es lo comodo en local: se arrancan dos nodos y aparecen solos.
#
# Ejemplo: un solo nodo semilla en una maquina, el resto se descubre solo.
# NODES=http://192.168.1.10:9944
#
# Ejemplo con tres validadores locales (el kit --init-genesis genera tres):
# NODES=http://127.0.0.1:9944,http://127.0.0.1:9945,http://127.0.0.1:9946
#
# Ejemplo con nodos en maquinas distintas, listados todos tal cual:
# NODES=http://192.168.1.10:9944,http://192.168.1.11:9945,http://192.168.1.12:9946

# Nodo al que se reenvia /rpc cuando no se declara NODES. El nodo no manda
# cabeceras CORS, asi que el navegador no puede llamarlo y el proxy hace de
# puente. Si declaras NODES, esta variable manda sobre el primero.
RPC_TARGET=http://127.0.0.1:9944

# Rango de puertos que se barren cuando no hay NODES.
SCAN_FROM=9944
SCAN_TO=9960

# Nodo por defecto, por indice dentro de la lista. Con NODE_DEFAULT vacio se
# usa el 0, o el que la pagina recuerde de la visita anterior.
# NODE_DEFAULT=0

# Directorio que se sirve. Vacio o ausente significa dist/.
# SERVE_DIR=dist

# Modo. Lo normal es no tocarlo; determina que .env.<modo> se lee.
# NODE_ENV=development
